-- CẤU HÌNH FIX CỨNG CHO MỌI EXECUTOR
local Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/UI-Rayfield/Main/main/lua'))()

local Window = Rayfield:CreateWindow({
   Name = "Delta Aim System [OFFICIAL]",
   LoadingTitle = "Bypassing Security...",
   LoadingSubtitle = "by System",
   ConfigurationSaving = { Enabled = false }
})

local Tab = Window:CreateTab("Combat", 4483362456)

-- TÍNH NĂNG AIM SĨ QUAN (ĐÃ FIX)
Tab:CreateToggle({
   Name = "Aim Lock [Head]",
   CurrentValue = false,
   Callback = function(State)
      _G.AimbotEnabled = State
   end
})

-- TÍNH NĂNG TỐC ĐỘ (DEBUG)
Tab:CreateSlider({
   Name = "WalkSpeed",
   Range = {16, 100},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(Value)
      game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
   end
})

-- NÚT KIỂM TRA (Nếu nút này không chạy, nghĩa là Delta chưa Inject thành công)
Tab:CreateButton({
   Name = "Kill All Targets",
   Callback = function()
      for _, player in pairs(game.Players:GetPlayers()) do
         if player ~= game.Players.LocalPlayer then
            player.Character:BreakJoints()
         end
      end
   end
})
